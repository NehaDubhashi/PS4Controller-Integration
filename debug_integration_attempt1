def accumulate(sq, sq_90, samples, num_it, samp):
    a_val = np.empty((num_it, 1))
    l = 0
    for i in range(0, num_it * samp, samp):
        a_i = np.sum(sq[i:i+samp] * np.abs(samples[i:i+samp]))
        a_q = np.sum(sq_90[i:i+samp] * np.abs(samples[i:i+samp]))
        a_val[l] = np.sqrt(np.abs(a_i**2 + a_q**2))
        l += 1
    return a_val[~np.isnan(a_val)]

def getBinary(a_val, th):
    s_d = np.empty((len(a_val), 1))
    for i in range(len(a_val)):
        s_d[i] = 1 if a_val[i] >= th else 0
    return s_d

def bandpower(x, fs, fmin, fmax):
    f, Pxx = signal.periodogram(x, fs=fs)
    ind_min = np.argmax(f > fmin) - 1
    ind_max = np.argmax(f > fmax) - 1
    return np.trapz(Pxx[ind_min:ind_max], f[ind_min:ind_max])

# ===============================
# Radio Recorder
# ===============================
class RadioRecorder:
    def __init__(self, center_freq=915e6, sample_rate=1e6, gain=2):
        self.sdr = RtlSdr()
        self.sdr.sample_rate = sample_rate
        self.sdr.center_freq = center_freq
        self.sdr.gain = gain
        self.recording = False
        self.stop_flag = False
        self.thread = None
        self.samples = None

    def _record_loop(self):
        sample_blocks = []
        block_size = 131072
        MIN_BLOCKS = 8

        print("RadioRecorder: Recording started.")
        start_time = time.time()

        while (not self.stop_flag) and (time.time() - start_time) < 90:
            block = self.sdr.read_samples(block_size)
            print("DEBUG: block size returned =", len(block))
            sample_blocks.append(block)

        print("DEBUG: finished read loop.")

        if not sample_blocks:
            print("ERROR: No samples captured.")
            return

        self.samples = np.concatenate(sample_blocks)
        print("DEBUG: Total samples =", self.samples.size)

        try:
            self.sdr.close()
        except Exception as e:
            print("WARNING: SDR close failed:", e)

        # ===============================
        # Signal processing
        # ===============================
        fs = self.sdr.sample_rate
        fb = 100
        dr = 1

        N = len(self.samples)
        t = np.arange(0, N / fs, 1/fs)

        sq = signal.square(2*np.pi*fb*t, duty=0.5)
        sq_90 = signal.square(2*np.pi*fb*t + np.pi/2, duty=0.5)

        max_cycles = fb / dr
        samps_per_bit = 2
        cycles = int(np.ceil(max_cycles) / samps_per_bit)

        Tmax = (1.0 / fb) * cycles
        samp = round(Tmax / (1.0/fs))
        num_it = int(N / samp)

        a_val = accumulate(sq, sq_90, self.samples, num_it, samp)
        s_d = getBinary(a_val, np.mean(a_val))
        bit_sequence = [int(b) for b in s_d.flatten()]

        print(f"DEBUG: Captured {len(bit_sequence)} bits")

        # ===============================
        # SAFE SAVE BLOCK (FIXED)
        # ===============================
        ts = datetime.now().strftime("%Y%m%d_%H%M%S")
        save_dir = "/home/astrobotic/Desktop/Controls/data"
        os.makedirs(save_dir, exist_ok=True)

        output_path = f"{save_dir}/sdr_record_{ts}.npz"
        print("DEBUG: Saving SDR NPZ to:", output_path)

        try:
            np.savez_compressed(
                output_path,
                samples=self.samples,
                a_val=a_val,
                s_d=s_d,
                bit_sequence=np.array(bit_sequence)
            )
            print("SUCCESS: SDR data saved.")
        except Exception as e:
            print("ERROR: Failed to save SDR NPZ:", repr(e))

        # ===============================
        # Temperature decode (UNCHANGED)
        # ===============================
        barker7 = [1,0,1,1,0,1,0]
        packet_length = 20
        temperatures_f = []
        timestamps = []

        for i in range(len(bit_sequence) - packet_length):
            if bit_sequence[i:i+7] == barker7:
                temp_bits = bit_sequence[i+7:i+20]
                temp_raw = int("".join(str(b) for b in temp_bits), 2)
                temp_f = (temp_raw * 0.0625 * 9/5) + 32
                temperatures_f.append(temp_f)
                timestamps.append(datetime.now().isoformat())

        if temperatures_f:
            temp_path = f"{save_dir}/temps_{ts}.npz"
            try:
                np.savez_compressed(temp_path,
                                    temperatures_f=temperatures_f,
                                    timestamps=timestamps)
                print("SUCCESS: temperature data saved.")
            except Exception as e:
                print("ERROR: Failed to save temperature NPZ:", repr(e))
        else:
            print("DEBUG: No valid temperature packets detected.")

    def start(self):
        if self.recording:
            print("RadioRecorder: Already recording.")
            return
        self.stop_flag = False
        self.recording = True
        self.thread = threading.Thread(target=self._record_loop)
        self.thread.start()

    def stop(self):
        print("RadioRecorder: stop requested.")
        self.stop_flag = True

    def close(self):
        try:
            self.sdr.close()
        except Exception as e:
            print("WARNING: SDR close error:", e)

