# ==========================
# DSP helpers
# ==========================
def accumulate(sq, sq_90, samples, num_it, samp):
    a_val = np.empty((num_it, 1))
    l = 0
    for i in range(0, num_it * samp, samp):
        a_i = np.sum(sq[i:i+samp] * np.abs(samples[i:i+samp]))
        a_q = np.sum(sq_90[i:i+samp] * np.abs(samples[i:i+samp]))
        a_val[l] = np.sqrt(a_i**2 + a_q**2)
        l += 1
    return a_val[~np.isnan(a_val)]

def getBinary(a_val, th):
    return (a_val >= th).astype(int)

# ==========================
# Radio Recorder
# ==========================
class RadioRecorder:
    def __init__(self, center_freq=915e6, sample_rate=1e6, gain=2):
        self.sdr = RtlSdr()
        self.sdr.sample_rate = sample_rate
        self.sdr.center_freq = center_freq
        self.sdr.gain = gain
        self.recording = False
        self.stop_flag = False
        self.thread = None
        self.samples = None

    def _record_loop(self):
        print("RadioRecorder: Recording started.")
        sample_blocks = []
        block_size = 131072
        MIN_BLOCKS = 8

        start_time = time.time()
        while not self.stop_flag and (time.time() - start_time) < 90:
            block = self.sdr.read_samples(block_size)
            sample_blocks.append(block)
            print("DEBUG: block captured =", len(block))

        print("DEBUG: exiting SDR read loop")

        if not sample_blocks:
            print("ERROR: No samples captured.")
            self.recording = False
            return

        self.samples = np.concatenate(sample_blocks)
        print("DEBUG: total samples =", self.samples.size)

        # --------------------------
        # Signal processing
        # --------------------------
        fs = self.sdr.sample_rate
        fb = 100
        N = len(self.samples)
        t = np.arange(N) / fs

        sq = signal.square(2*np.pi*fb*t)
        sq_90 = signal.square(2*np.pi*fb*t + np.pi/2)

        samp = int(fs / fb)
        num_it = int(N / samp)

        a_val = accumulate(sq, sq_90, self.samples, num_it, samp)
        s_d = getBinary(a_val, np.mean(a_val))
        bit_sequence = s_d.flatten().tolist()

        print(f"DEBUG: decoded {len(bit_sequence)} bits")

        # --------------------------
        # SAFE SAVE BLOCK
        # --------------------------
        ts = datetime.now().strftime("%Y%m%d_%H%M%S")
        save_dir = "/home/astrobotic/Desktop/Controls/data"
        os.makedirs(save_dir, exist_ok=True)

        output_path = f"{save_dir}/sdr_record_{ts}.npz"
        print("DEBUG: saving SDR data to:", output_path)

        try:
            np.savez_compressed(
                output_path,
                samples=self.samples,
                a_val=a_val,
                s_d=s_d,
                bit_sequence=np.array(bit_sequence)
            )
            print("SUCCESS: SDR NPZ saved.")
        except Exception as e:
            print("ERROR: Failed to save SDR NPZ:", repr(e))

        # --------------------------
        # Temperature decode
        # --------------------------
        barker7 = [1,0,1,1,0,1,0]
        temps_f = []
        timestamps = []

        for i in range(len(bit_sequence) - 20):
            if bit_sequence[i:i+7] == barker7:
                temp_bits = bit_sequence[i+7:i+20]
                raw = int("".join(map(str, temp_bits)), 2)
                temp_f = (raw * 0.0625 * 9/5) + 32
                temps_f.append(temp_f)
                timestamps.append(datetime.now().isoformat())

        if temps_f:
            temp_path = f"{save_dir}/temps_{ts}.npz"
            try:
                np.savez_compressed(temp_path,
                                    temperatures_f=temps_f,
                                    timestamps=timestamps)
                print("SUCCESS: temperature NPZ saved.")
            except Exception as e:
                print("ERROR: Failed to save temps:", repr(e))
        else:
            print("DEBUG: no valid temperature packets")

        self.recording = False
        print("RadioRecorder: recording complete.")

    def start(self):
        if self.recording:
            return
        self.stop_flag = False
        self.recording = True
        self.thread = threading.Thread(target=self._record_loop)  # NOT daemon
        self.thread.start()

    def stop(self):
        print("RadioRecorder: stop requested")
        self.stop_flag = True
        if self.thread:
            self.thread.join()
        self.recording = False

    def close(self):
        try:
            self.sdr.close()
        except:
            pass

radio_recorder = RadioRecorder()

# ==========================
# Controller
# ==========================
class BaseController(Controller):
    def on_square_press(self):
        print("Square -> start recording")
        radio_recorder.start()

    def on_circle_press(self):
        print("Circle -> stop recording")
        radio_recorder.stop()

    def on_x_press(self):
        print("X -> emergency stop")
        rc.SpeedM1(address1, 0)
        rc.SpeedM2(address1, 0)
        rc.SpeedM1(address2, 0)
        rc.SpeedM2(address2, 0)
        radio_recorder.stop()
        radio_recorder.close()
        sys.exit(0)

class JoystickController(BaseController):
    def __init__(self, maxSpeed, deadZone, **kwargs):
        super().__init__(**kwargs)
        self.maxSpeed = maxSpeed
        self.deadZone = deadZone

    def mapSpeed(self, value):
        return 0 if abs(value) < self.deadZone else int((abs(value)/32767)*self.maxSpeed)

    def on_L3_up(self, value):
        s = self.mapSpeed(value)
        rc.SpeedM1(address1, -s)
        rc.SpeedM2(address2, -s)

    def on_L3_down(self, value):
        s = self.mapSpeed(value)
        rc.SpeedM1(address1, s)
        rc.SpeedM2(address2, s)

# ==========================
# Main
# ==========================
def main():
    while not os.path.exists("/dev/input/js0"):
        time.sleep(1)

    controller = JoystickController(
        maxSpeed=12000,
        deadZone=2000,
        interface="/dev/input/js0",
        connecting_using_ds4drv=False
    )
    print("Controller ready.")
    controller.listen()

if __name__ == "__main__":
    main()
