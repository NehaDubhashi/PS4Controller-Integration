# ===============================
# Radio Recorder
# ===============================
class RadioRecorder:
    def __init__(self, center_freq=915e6, sample_rate=1e6, gain=2):
        self.center_freq = center_freq
        self.sample_rate = sample_rate
        self.gain = gain

        self.sdr = None
        self.thread = None
        self.recording = False
        self.stop_flag = False

        # outputs
        self.a_vals = []

        # raw sync (debug only)
        self.RAW_SYNC_MAX_SAMPLES = int(1 * sample_rate)  # 1 second
        self.raw_sync_buf = []
        self.raw_sync_count = 0

    def _open_sdr(self):
        self.sdr = RtlSdr()
        self.sdr.sample_rate = self.sample_rate
        self.sdr.center_freq = self.center_freq
        self.sdr.gain = self.gain

    def _record_loop(self):
        try:
            self._open_sdr()

            fs = self.sample_rate
            fb = 100
            dr = 1
            block_size = 131072

            print("RadioRecorder: Recording started")

            start_time = time.time()
            while not self.stop_flag and (time.time() - start_time) < 90:
                block = self.sdr.read_samples(block_size)

                # ---------- RAW SYNC (LIMITED) ----------
                if self.raw_sync_count < self.RAW_SYNC_MAX_SAMPLES:
                    t = np.arange(len(block)) / fs
                    sq = signal.square(2 * np.pi * fb * t)
                    sq90 = signal.square(2 * np.pi * fb * t + np.pi / 2)

                    env = np.abs(block)
                    raw_mag = np.sqrt((sq * env) ** 2 + (sq90 * env) ** 2)

                    remaining = self.RAW_SYNC_MAX_SAMPLES - self.raw_sync_count
                    self.raw_sync_buf.append(raw_mag[:remaining])
                    self.raw_sync_count += len(raw_mag[:remaining])

                # ---------- SYMBOL-LEVEL ACCUMULATION ----------
                max_cycles = fb / dr
                samps_per_bit = 2
                cycles = int(np.ceil(max_cycles) / samps_per_bit)
                Tmax = (1.0 / fb) * cycles
                samp = int(Tmax * fs)

                for i in range(0, len(block) - samp, samp):
                    t_sym = np.arange(samp) / fs
                    sq = signal.square(2 * np.pi * fb * t_sym)
                    sq90 = signal.square(2 * np.pi * fb * t_sym + np.pi / 2)

                    env = np.abs(block[i:i+samp])
                    a_i = np.sum(sq * env)
                    a_q = np.sum(sq90 * env)
                    a = np.sqrt(a_i**2 + a_q**2)
                    self.a_vals.append(a)

            print("RadioRecorder: Finished acquisition")

        finally:
            try:
                if self.sdr:
                    self.sdr.close()
            except:
                pass

            self._finalize_and_save()
            self.recording = False
            self.stop_flag = False
            print("RadioRecorder: Recording thread exited cleanly")

    def _finalize_and_save(self):
        if not self.a_vals:
            print("No data captured; nothing to save")
            return

        a_val = np.array(self.a_vals)
        threshold = np.mean(a_val)
        bit_sequence = (a_val >= threshold).astype(int)

        raw_sync = (
            np.concatenate(self.raw_sync_buf)
            if self.raw_sync_buf else None
        )

        ts = datetime.now().strftime("%Y%m%d_%H%M%S")
        out = f"/home/astrobotic/Desktop/Controls/data/sdr_record_{ts}.npz"

        np.savez_compressed(
            out,
            a_val=a_val,
            bit_sequence=bit_sequence,
            raw_sync=raw_sync,
            fs=self.sample_rate,
            fb=100
        )

        print(f"SUCCESS: Saved capture to {out}")

    def start(self):
        if self.recording:
            print("RadioRecorder: Already recording")
            return

        self.stop_flag = False
        self.recording = True
        self.thread = threading.Thread(target=self._record_loop)
        self.thread.start()

    def stop(self):
        if not self.recording:
            return
        print("RadioRecorder: stop requested")
        self.stop_flag = True

    def close(self):
        if self.thread:
            self.thread.join()
            self.thread = None

