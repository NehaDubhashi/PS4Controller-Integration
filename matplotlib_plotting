import glob
import numpy as np
import matplotlib.pyplot as plt

# -------------------------------
# Load latest capture
# -------------------------------
files = sorted(
    glob.glob("/home/astrobotic/Desktop/Controls/data/sdr_record_*.npz")
)
latest = files[-1]
print("Loading:", latest)

data = np.load(latest)
a_val = data["a_val"].flatten()

# Binary decision (same as before)
def getBinary(a_val, th):
    return (a_val >= th).astype(int)

threshold = np.mean(a_val)
s_d = getBinary(a_val, threshold)

print("Mean(a_val):", np.mean(a_val))
print("Num symbols:", len(a_val))

# -------------------------------
# Plot
# -------------------------------
plt.figure(figsize=(8, 6))

# ---- Top: synchronous detection output (integrated) ----
plt.subplot(2, 1, 1)
plt.plot(a_val, '.-', markersize=6)
plt.axhline(threshold, linestyle='--')
plt.title('Signal after Synchronous Detection')
plt.ylabel('Accumulator Magnitude')
plt.grid(True)

# ---- Bottom: 0/1 representation ----
plt.subplot(2, 1, 2)
plt.plot(s_d, '.-')
plt.ylim(-0.2, 1.2)
plt.title('Signal in 0/1s Representation')
plt.xlabel('Symbol Index')
plt.ylabel('Bit')
plt.grid(True)

plt.tight_layout()

out = latest.replace(".npz", "_sync_detect.png")
plt.savefig(out)
print("Saved plot to:", out)
