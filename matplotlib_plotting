import glob
import os
import numpy as np
import matplotlib.pyplot as plt

# ===============================
# Find latest SDR capture
# ===============================
data_dir = "/home/astrobotic/Desktop/Controls/data"
files = sorted(
    glob.glob(os.path.join(data_dir, "sdr_record_*.npz")),
    key=os.path.getmtime
)

if not files:
    raise RuntimeError("No sdr_record_*.npz files found")

latest = files[-1]
print("Loading latest capture:")
print(latest)

data = np.load(latest)

a_val = data["a_val"].flatten()
s_d = data["s_d"].flatten()

threshold = np.mean(a_val)

print("Num symbols:", len(a_val))
print("Mean(a_val):", threshold)
print("Max(a_val):", np.max(a_val))

# ===============================
# Plot (RAW, no normalization)
# ===============================
plt.figure(figsize=(10, 7))

# --- Top: synchronous detection output ---
plt.subplot(2, 1, 1)
plt.plot(a_val, ".-", linewidth=1)
plt.axhline(threshold, color="r", linestyle="--", label="Mean threshold")
plt.title("Signal after Synchronous Detection")
plt.ylabel("Accumulator Magnitude")
plt.grid(True)
plt.legend()

# --- Bottom: binary decisions ---
plt.subplot(2, 1, 2)
plt.step(range(len(s_d)), s_d, where="post")
plt.ylim(-0.2, 1.2)
plt.title("Signal in 0/1s Representation")
plt.xlabel("Symbol Index")
plt.ylabel("Bit")
plt.grid(True)

plt.tight_layout()
plt.show()
